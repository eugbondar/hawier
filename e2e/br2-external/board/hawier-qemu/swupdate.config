# SWUpdate for the hawier reference device (spec: reference-device-image).
# Only what a hardened suricatta device needs. Buildroot runs olddefconfig
# over this, so every option that defaults on and is not wanted is named
# here as off.

# Hardened policy: signed images only, exact hardware revision.
CONFIG_SSL_IMPL_OPENSSL=y
CONFIG_SIGNED_IMAGES=y
CONFIG_SIGALG_RAWRSA=y
CONFIG_HW_COMPATIBILITY=y
CONFIG_HW_COMPATIBILITY_FILE="/etc/hwrevision"
CONFIG_SW_VERSIONS_FILE="/etc/sw-versions"

# Talks to hawier as a hawkBit server.
CONFIG_SURICATTA=y
CONFIG_SURICATTA_HAWKBIT=y
CONFIG_CHANNEL_CURL=y

# Slots are switched and update state is kept in the GRUB environment block
# on the boot partition, mounted at /bootpart.
CONFIG_BOOTLOADER_GRUB=y
# CONFIG_BOOTLOADER_NONE is not set
CONFIG_BOOTLOADER_DEFAULT_GRUB=y
CONFIG_GRUBENV_PATH="/bootpart/boot/grub/grubenv"
CONFIG_UPDATE_STATE_CHOICE_BOOTLOADER=y
CONFIG_UPDATE_STATE_BOOTLOADER="ustate"

CONFIG_LIBCONFIG=y
CONFIG_RAW=y
# Registers the `bootenv` handler sw-description uses to switch rootslot;
# without it SWUpdate refuses any image that touches the bootloader.
CONFIG_BOOTLOADERHANDLER=y

# Off: no web server, no Lua, nothing for flash, no compression handlers
# (a SquashFS slot is compressed already).
# CONFIG_WEBSERVER is not set
# CONFIG_LUA is not set
# CONFIG_MTD is not set
# CONFIG_UBIATTACH is not set
# CONFIG_GUNZIP is not set
# CONFIG_ZSTD is not set
# CONFIG_SCRIPTS is not set
# CONFIG_LOCALE is not set
# CONFIG_DOWNLOAD is not set
# CONFIG_ENCRYPTED_IMAGES is not set
